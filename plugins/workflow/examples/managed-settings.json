{
  "allowManagedPermissionRulesOnly": true,
  "allowManagedMcpServersOnly": true,
  "disableSideloadFlags": true,
  "disableAllHooks": false,
  "forceLoginMethod": "claudeai",
  "forceLoginOrgUUID": "REPLACE_WITH_BELTA_ORG_UUID",
  "requiredMinimumVersion": "2.1.208",
  "cleanupPeriodDays": 30,
  "allowedMcpServers": [
    { "serverName": "claude_ai_Notion" },
    { "serverName": "claude_ai_Slack" },
    { "serverName": "claude_ai_Google_Drive" },
    { "serverName": "scheduled-tasks" }
  ],
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "allowUnsandboxedCommands": true,
    "excludedCommands": ["gh *", "docker *", "open *", "osascript *"],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org"
      ]
    },
    "filesystem": {
      "denyRead": [".env", "~/.env"]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws/credentials", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Read",
      "Edit(.belta/**)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/skills/**)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(gh auth status)",
      "Bash(gh repo view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(gh api * --method GET*)",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-query-*",
      "mcp__claude_ai_Notion__notion-get-*",
      "mcp__claude_ai_Slack__slack_read_*",
      "mcp__claude_ai_Slack__slack_search_*",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Google_Drive__list_recent_files",
      "mcp__claude_ai_Google_Drive__get_file_metadata",
      "mcp__claude_ai_Google_Drive__download_file_content"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git reset:*)",
      "Bash(gh auth token)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh gist create:*)",
      "Bash(gh api * --method POST*)",
      "Bash(gh api * --method PATCH*)",
      "Bash(gh api * --method PUT*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(http:*)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/settings.local.json)",
      "Agent(model:fable)",
      "Agent(model:claude-fable-5)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas",
      "mcp__claude_ai_Notion__notion-create-*",
      "mcp__claude_ai_Notion__notion-update-*",
      "mcp__claude_ai_Notion__notion-duplicate-page",
      "mcp__claude_ai_Notion__notion-move-pages",
      "mcp__claude_ai_Google_Drive__create_file",
      "mcp__claude_ai_Google_Drive__copy_file"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(chmod -R:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue close:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "mcp__claude_ai_Slack__*delete*",
      "mcp__claude_ai_Google_Drive__*delete*",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.env)",
      "Read(//**/.ssh/**)",
      "Read(//**/id_rsa*)",
      "Read(//**/*.pem)",
      "Read(~/.aws/credentials)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/id_rsa*)",
      "Edit(//**/*.pem)",
      "Bash(cat *.env)",
      "Bash(cat *.env.*)"
    ]
  }
}
